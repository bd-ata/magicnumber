<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <!-- 增加 maximum-scale=1.0 與 user-scalable=no 防止手機雙擊或捏合縮放 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>魔法數字派對 - 乘法特訓版</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@700;900&display=swap');

        body {
            background-color: #E5D9DD; 
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            font-family: 'Nunito', sans-serif;
            overflow: hidden;
            touch-action: none; 
        }

        /* 遊戲大廳設定面板 */
        .settings-panel {
            background: #FFF;
            padding: 30px 40px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            text-align: center;
            width: 90%;
            max-width: 600px;
            max-height: 90vh;
            overflow-y: auto;
            box-sizing: border-box;
            z-index: 2000;
        }

        .settings-panel h1 { color: #5D535E; font-size: 38px; margin-top: 0; margin-bottom: 5px; }
        .settings-panel .subtitle { color: #E57373; font-size: 20px; font-weight: bold; margin-bottom: 25px; }

        .setting-group { margin-bottom: 20px; text-align: left; }
        .setting-group label { font-size: 20px; color: #42A5F5; font-weight: 900; display: block; margin-bottom: 10px; }
        .options { display: flex; gap: 10px; flex-wrap: wrap; }
        
        .opt-btn {
            background: #F4EAE6; color: #5D535E; border: 2px solid transparent;
            padding: 10px 20px; font-size: 18px; border-radius: 15px; font-weight: bold;
            cursor: pointer; transition: all 0.2s;
            flex: 1 1 auto;
            text-align: center;
        }
        .opt-btn.active { background: #FF9800; color: #FFF; border-color: #E65100; transform: scale(1.05); box-shadow: 0 4px 10px rgba(255,152,0,0.3); }

        .start-btn {
            background: #E57373; color: white; border: none; width: 100%;
            padding: 18px; font-size: 26px; border-radius: 30px; font-weight: bold;
            cursor: pointer; box-shadow: 0 6px 0 #C62828; margin-top: 10px; transition: 0.1s;
        }
        .start-btn:active { transform: translateY(6px); box-shadow: 0 0 0 #C62828; }

        /* 遊戲區域 */
        #battle-arena {
            display: flex; flex-wrap: wrap; gap: 20px; width: 100%;
            justify-content: center; align-items: center;
            transform-origin: center; transition: transform 0.3s;
        }

        .player-wrapper { display: flex; flex-direction: column; align-items: center; }
        .player-title { font-size: 28px; font-weight: 900; margin-bottom: 5px; text-shadow: 2px 2px 0 #FFF; }
        
        .header { display: flex; justify-content: space-between; width: 300px; margin-bottom: 5px; font-size: 18px; font-weight: 900; }
        .score-board { color: #FF9800; }
        .speed-indicator { color: #E57373; }

        .current-sum-display {
            font-size: 20px; background: rgba(255, 255, 255, 0.7); padding: 5px 20px;
            border-radius: 20px; margin-bottom: 10px; font-weight: bold; transition: color 0.2s;
            text-align: center; width: 260px; height: 30px; display: flex; align-items: center; justify-content: center;
        }

        .game-container {
            position: relative; width: 300px; height: 420px; background: rgba(255, 255, 255, 0.3);
            border: 4px solid #B8A9AB; border-radius: 10px; overflow: hidden; box-shadow: inset 0 0 20px rgba(0,0,0,0.05);
        }

        .danger-zone { position: absolute; bottom: 0; width: 100%; height: 12px; z-index: 100; transition: box-shadow 0.3s; }

        .hexagon {
            position: absolute; width: 50px; height: 57px; background-color: #D3C4D1;
            clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
            display: flex; align-items: center; justify-content: center;
            font-size: 24px; color: #5D535E; font-weight: bold; cursor: pointer; user-select: none;
            transition: background-color 0.1s, transform 0.1s;
        }
        .hexagon:active { transform: scale(0.9); }
        .hexagon.selected { background-color: #FFF2B2 !important; transform: scale(1.15); color: #FF9800; z-index: 10; box-shadow: 0 0 10px #FFEB3B; }
        .hexagon.flash { background-color: #FFF !important; transform: scale(1.3); opacity: 0; transition: all 0.3s ease-out; }

        .particle {
            position: absolute; width: 10px; height: 10px; background-color: #FFEB3B;
            clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
            pointer-events: none; z-index: 1000; transition: transform 0.6s ease-out, opacity 0.6s ease-out;
        }

        .floating-text {
            position: absolute; font-size: 22px; font-weight: 900; z-index: 999; pointer-events: none;
            animation: floatUp 1s forwards; text-shadow: 2px 2px 0 #FFF, -2px -2px 0 #FFF, 2px -2px 0 #FFF, -2px 2px 0 #FFF;
        }
        @keyframes floatUp { 0% { opacity: 1; transform: translateY(0) scale(1); } 100% { opacity: 0; transform: translateY(-40px) scale(1.5); } }

        /* 全螢幕覆蓋層 */
        .overlay {
            position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(229, 217, 221, 0.95); display: flex; flex-direction: column;
            align-items: center; justify-content: center; z-index: 2000;
        }
        .hidden { display: none !important; }

        /* 華麗結算畫面 */
        #game-over-screen { background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(5px); padding: 20px; text-align: center; }
        .winner-text { 
            font-size: 60px; margin: 10px 0; 
            background: linear-gradient(to right, #FF9800, #FFEB3B, #4CAF50, #00BCD4, #E91E63);
            -webkit-background-clip: text; color: transparent;
            animation: pulse 1s infinite alternate; text-shadow: 0 0 20px rgba(255,255,255,0.3);
        }
        @keyframes pulse { from { transform: scale(1); } to { transform: scale(1.1); } }

        /* 彩色紙片 (Confetti) */
        .confetti { position: absolute; width: 10px; height: 20px; z-index: 3000; animation: fall linear forwards; }
        @keyframes fall { to { transform: translateY(100vh) rotate(720deg); } }

        /* 手機適配 (響應式設計) */
        @media (max-width: 768px) {
            .settings-panel { padding: 20px; }
            .settings-panel h1 { font-size: 32px; }
            .opt-btn { font-size: 16px; padding: 10px; flex: 1 1 calc(50% - 10px); }
            .start-btn { font-size: 22px; padding: 15px; }
            .winner-text { font-size: 40px; }
        }
    </style>
</head>
<body>

    <!-- 遊戲大廳設定 -->
    <div id="start-screen" class="overlay">
        <div class="settings-panel">
            <h1>魔法數字派對</h1>
            <div class="subtitle">算數特訓版 🚀</div>

            <div class="setting-group">
                <label>👥 玩家人數</label>
                <div class="options" id="opt-players">
                    <div class="opt-btn active" data-val="1">單人挑戰</div>
                    <div class="opt-btn" data-val="2">雙人 PK</div>
                    <div class="opt-btn" data-val="3">三人大亂鬥</div>
                </div>
            </div>

            <div class="setting-group">
                <label>🎮 遊戲模式</label>
                <div class="options" id="opt-mode">
                    <div class="opt-btn active" data-val="10">合 10</div>
                    <div class="opt-btn" data-val="20">合 20</div>
                    <div class="opt-btn" data-val="multi">乘法特訓 ✖️</div>
                </div>
            </div>

            <div class="setting-group">
                <label>🎵 背景音樂</label>
                <div class="options" id="opt-bgm">
                    <div class="opt-btn" data-val="relax">輕鬆休閒</div>
                    <div class="opt-btn active" data-val="arcade">復古街機</div>
                    <div class="opt-btn" data-val="tense">極限刺激</div>
                </div>
            </div>

            <button class="start-btn" onclick="applySettingsAndStart()">開始遊戲！</button>
        </div>
    </div>

    <!-- 華麗結算畫面 -->
    <div id="game-over-screen" class="overlay hidden">
        <h1 style="color: white; text-shadow: none;">GAME OVER</h1>
        <h2 id="winner-display" class="winner-text">1P 獲勝！</h2>
        <button class="start-btn" style="width:auto; padding: 15px 40px;" onclick="location.reload()">回主畫面</button>
    </div>

    <!-- 遊戲動態生成區域 -->
    <div id="battle-arena"></div>

    <script>
        // --- 設定狀態與 UI 互動 ---
        const config = { players: 1, mode: '10', bgm: 'arcade' };

        document.querySelectorAll('.options').forEach(group => {
            group.addEventListener('click', (e) => {
                if (e.target.classList.contains('opt-btn')) {
                    group.querySelectorAll('.opt-btn').forEach(b => b.classList.remove('active'));
                    e.target.classList.add('active');
                    let key = group.id.split('-')[1];
                    let val = e.target.dataset.val;
                    config[key] = (key === 'players') ? parseInt(val) : val;
                }
            });
        });

        const THEMES = [
            { id: 'p1', name: '1P (藍)', color: '#42A5F5', border: '#90CAF9', bg: 'rgba(144, 202, 249, 0.1)' },
            { id: 'p2', name: '2P (紅)', color: '#EF5350', border: '#EF9A9A', bg: 'rgba(239, 154, 154, 0.1)' },
            { id: 'p3', name: '3P (綠)', color: '#66BB6A', border: '#A5D6A7', bg: 'rgba(165, 214, 167, 0.1)' }
        ];

        // 動態計算縮放比例，讓多人模式在手機上也能全螢幕顯示不跑版
        function resizeArena() {
            const arena = document.getElementById('battle-arena');
            if (arena.innerHTML === '') return;
            
            const isMobile = window.innerWidth <= 768;
            
            // 手機上多人模式垂直排列，桌面端水平排列
            arena.style.flexDirection = (isMobile && config.players > 1) ? 'column' : 'row';
            arena.style.transform = 'scale(1)'; // 重置計算
            
            const wrapperWidth = 320; 
            const wrapperHeight = 540; 
            
            let totalWidth, totalHeight;
            if (isMobile && config.players > 1) {
                totalWidth = wrapperWidth;
                totalHeight = wrapperHeight * config.players;
            } else {
                totalWidth = wrapperWidth * config.players;
                totalHeight = wrapperHeight;
            }
            
            // 計算長寬所需的縮放比例，保留 5% 的邊距
            const scaleX = window.innerWidth / totalWidth;
            const scaleY = window.innerHeight / totalHeight;
            const scale = Math.min(scaleX, scaleY, 1) * 0.95; 
            
            arena.style.transform = `scale(${scale})`;
        }

        window.addEventListener('resize', resizeArena);

        function applySettingsAndStart() {
            document.getElementById('start-screen').classList.add('hidden');
            const arena = document.getElementById('battle-arena');
            arena.innerHTML = ''; 

            players = [];
            for (let i = 0; i < config.players; i++) {
                let p = new PlayerBoard(THEMES[i]);
                players.push(p);
                arena.appendChild(p.createDOM());
                p.reset();
            }

            players.forEach(p => p.opponents = players.filter(other => other !== p));
            
            resizeArena(); // 執行自適應縮放

            globalGameOver = false;
            initAudio();
            startBGM(config.bgm);
            cancelAnimationFrame(mainLoopId);
            mainLoopId = requestAnimationFrame(gameLoop);
        }

        // --- 音效引擎 ---
        let audioCtx;
        let bgmInterval;

        function initAudio() {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (audioCtx.state === 'suspended') audioCtx.resume();
        }

        function playTone(freq, type, duration, vol) {
            if (!audioCtx) return;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
            gain.gain.setValueAtTime(vol, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
            osc.connect(gain); gain.connect(audioCtx.destination);
            osc.start(); osc.stop(audioCtx.currentTime + duration);
        }

        function playClickSound() { playTone(800, 'sine', 0.1, 0.05); }
        function playCancelSound() { playTone(300, 'triangle', 0.15, 0.05); }
        function playClearSound() { playTone(400, 'square', 0.1, 0.05); setTimeout(() => playTone(800, 'square', 0.2, 0.05), 100); }
        function playAttackSound() { playTone(900, 'sawtooth', 0.1, 0.1); setTimeout(() => playTone(700, 'sawtooth', 0.2, 0.1), 100); }
        function playGameOverSound() { playTone(300, 'sawtooth', 0.5, 0.1); setTimeout(() => playTone(200, 'sawtooth', 1.0, 0.1), 300); }

        function startBGM(style) {
            clearInterval(bgmInterval);
            let notes, type, speed, vol;
            if (style === 'relax') {
                notes = [261, 329, 392, 523, 392, 329]; type = 'triangle'; speed = 400; vol = 0.03;
            } else if (style === 'arcade') {
                notes = [196, 0, 196, 233, 196, 0, 261, 233]; type = 'square'; speed = 180; vol = 0.02;
            } else { 
                notes = [100, 105, 110, 115, 120, 115, 110, 105]; type = 'sawtooth'; speed = 120; vol = 0.04;
            }
            let i = 0;
            bgmInterval = setInterval(() => {
                let freq = notes[i % notes.length];
                if (freq > 0) playTone(freq, type, 0.1, vol); 
                i++;
            }, speed); 
        }
        function stopBGM() { clearInterval(bgmInterval); }

        // --- 核心遊戲類別 ---
        const HEX_WIDTH = 50; const HEX_HEIGHT = 57; const ROW_HEIGHT = 42; const DANGER_Y = 405;
        let globalGameOver = false; let mainLoopId; let players = [];

        class PlayerBoard {
            constructor(theme) {
                this.theme = theme;
                this.opponents = [];
            }

            createDOM() {
                const wrapper = document.createElement('div');
                wrapper.className = 'player-wrapper';
                wrapper.innerHTML = `
                    <div class="player-title" style="color: ${this.theme.color};">${this.theme.name}</div>
                    <div class="header">
                        <div>⭐ <span id="${this.theme.id}-score">0</span></div>
                        <div id="${this.theme.id}-speed">🚀 Lv.1</div>
                    </div>
                    <div class="current-sum-display" id="${this.theme.id}-sum-box"></div>
                    <div class="game-container" id="${this.theme.id}-container" style="border-color: ${this.theme.border}; background: ${this.theme.bg};">
                        <div class="danger-zone" style="background: repeating-linear-gradient(45deg, ${this.theme.color}, ${this.theme.color} 10px, #333 10px, #333 20px);"></div>
                    </div>
                `;
                return wrapper;
            }

            reset() {
                this.container = document.getElementById(`${this.theme.id}-container`);
                this.scoreDisplay = document.getElementById(`${this.theme.id}-score`);
                this.speedDisplay = document.getElementById(`${this.theme.id}-speed`);
                this.sumBox = document.getElementById(`${this.theme.id}-sum-box`);
                
                this.container.querySelectorAll('.hexagon, .particle, .floating-text').forEach(el => el.remove());
                this.activeHexes = []; this.selectedObjs = [];
                this.currentSum = 0; this.score = 0; this.rowIndex = 0; this.topMostY = 0;
                this.currentTarget = 0; 
                
                this.speed = 0.05; this.baseSpeed = 0.05;
                this.scoreDisplay.innerText = 0;
                
                // 開局生成幾排數字
                for(let y = 150; y >= -ROW_HEIGHT; y -= ROW_HEIGHT) this.generateRow(y);

                if (config.mode === 'multi') this.generateNewTarget();
                else this.updateSumDisplay();
            }

            generateRow(y) {
                let count = this.rowIndex % 2 === 0 ? 6 : 5;
                let offsetX = this.rowIndex % 2 === 0 ? 0 : 25;

                for (let c = 0; c < count; c++) {
                    let hex = document.createElement('div');
                    hex.classList.add('hexagon');
                    let val = Math.floor(Math.random() * 9) + 1; // 隨機 1~9
                    hex.innerText = val;

                    let obj = { el: hex, val: val, x: c * HEX_WIDTH + offsetX, y: y };
                    hex.style.left = obj.x + 'px'; hex.style.top = obj.y + 'px';
                    
                    hex.addEventListener('pointerdown', (e) => { e.preventDefault(); this.handleHexClick(obj); });
                    
                    this.container.appendChild(hex);
                    this.activeHexes.push(obj);
                }
                this.rowIndex++; this.topMostY = y;
            }

            generateNewTarget() {
                if (this.activeHexes.length >= 2) {
                    let idx1 = Math.floor(Math.random() * this.activeHexes.length);
                    let idx2 = Math.floor(Math.random() * this.activeHexes.length);
                    while(idx1 === idx2 && this.activeHexes.length > 1) {
                        idx2 = Math.floor(Math.random() * this.activeHexes.length);
                    }
                    this.currentTarget = this.activeHexes[idx1].val * this.activeHexes[idx2].val;
                } else {
                    this.currentTarget = (Math.floor(Math.random() * 9) + 1) * (Math.floor(Math.random() * 9) + 1);
                }
                this.updateSumDisplay();
            }

            handleHexClick(obj) {
                if (globalGameOver) return;
                
                let index = this.selectedObjs.indexOf(obj);
                if (index > -1) {
                    obj.el.classList.remove('selected');
                    this.selectedObjs.splice(index, 1);
                    if (config.mode !== 'multi') this.currentSum -= obj.val;
                    playCancelSound();
                    this.updateSumDisplay();
                    return;
                }

                if (config.mode === 'multi' && this.selectedObjs.length >= 2) return;

                obj.el.classList.add('selected');
                this.selectedObjs.push(obj);
                if (config.mode !== 'multi') this.currentSum += obj.val;
                playClickSound();

                this.updateSumDisplay();

                if (config.mode === 'multi') {
                    if (this.selectedObjs.length === 2) {
                        let prod = this.selectedObjs[0].val * this.selectedObjs[1].val;
                        if (prod === this.currentTarget) {
                            let toClear = [...this.selectedObjs];
                            this.selectedObjs = [];
                            this.processClear(toClear);
                            this.generateNewTarget();
                        } else {
                            let toReset = [...this.selectedObjs];
                            this.selectedObjs = [];
                            this.updateSumDisplay();
                            playCancelSound();
                            toReset.forEach(o => {
                                o.el.style.backgroundColor = '#E57373'; o.el.style.color = '#FFF';
                                setTimeout(() => {
                                    if (!this.selectedObjs.includes(o)) {
                                        o.el.style.backgroundColor = ''; o.el.style.color = ''; o.el.classList.remove('selected');
                                    }
                                }, 300);
                            });
                        }
                    }
                } else {
                    let target = parseInt(config.mode);
                    if (this.currentSum === target) {
                        let toClear = [...this.selectedObjs];
                        this.selectedObjs = []; this.currentSum = 0; this.updateSumDisplay();
                        this.processClear(toClear);
                    } else if (this.currentSum > target) {
                        let toReset = [...this.selectedObjs];
                        this.selectedObjs = []; this.currentSum = 0; this.updateSumDisplay();
                        playCancelSound();
                        toReset.forEach(o => {
                            o.el.style.transform = 'scale(0.8)';
                            setTimeout(() => { o.el.style.transform = ''; o.el.classList.remove('selected'); }, 200);
                        });
                    }
                }
            }

            updateSumDisplay() {
                if (config.mode === 'multi') {
                    if (this.selectedObjs.length === 1) {
                        this.sumBox.innerHTML = `🎯 找相乘 = <span style="color:#D32F2F">${this.currentTarget}</span> ( ${this.selectedObjs[0].val} × ? )`;
                    } else {
                        this.sumBox.innerHTML = `🎯 找相乘 = <span style="color:#D32F2F">${this.currentTarget}</span>`;
                    }
                    this.sumBox.style.color = '#5D535E';
                } else {
                    let target = parseInt(config.mode);
                    this.sumBox.innerHTML = `加總：<span>${this.currentSum}</span> / ${target}`;
                    if (this.currentSum === target) this.sumBox.style.color = '#FF9800';
                    else if (this.currentSum > target) this.sumBox.style.color = '#E57373';
                    else this.sumBox.style.color = '#5D535E';
                }
            }

            processClear(hexesToClear) {
                playClearSound();
                let scoreGain = hexesToClear.length * 10;
                this.score += scoreGain;
                this.scoreDisplay.innerText = this.score;
                
                hexesToClear.forEach(obj => {
                    let index = this.activeHexes.indexOf(obj);
                    if (index > -1) this.activeHexes.splice(index, 1); 
                    this.spawnParticles(obj.x + 25, obj.y + 28); 
                    obj.el.classList.add('flash');
                    setTimeout(() => obj.el.remove(), 300);
                });
                
                let lastObj = hexesToClear[hexesToClear.length - 1];

                let isAttack = false;
                if (config.mode === 'multi') isAttack = true; 
                else if (hexesToClear.length >= 3) isAttack = true; 

                if (config.players > 1 && isAttack) {
                    playAttackSound();
                    this.spawnFloatingText(lastObj.x, lastObj.y, `攻擊!`, '#D32F2F');
                    let attackPower = (config.mode === 'multi') ? 0.03 : 0.05; 
                    this.opponents.forEach(opp => opp.receiveAttack(attackPower));
                } else {
                    this.spawnFloatingText(lastObj.x, lastObj.y, `+${scoreGain}`, '#FF9800');
                }
            }

            receiveAttack(power) {
                this.speed += power; 
                this.container.style.boxShadow = "inset 0 0 40px rgba(229, 115, 115, 0.9)";
                setTimeout(() => { this.container.style.boxShadow = "inset 0 0 20px rgba(0,0,0,0.05)"; }, 400);
            }

            update() {
                if (globalGameOver) return;
                this.speed += 0.00003; 
                
                let level = Math.floor((this.speed - this.baseSpeed) / 0.05) + 1;
                this.speedDisplay.innerText = `🚀 Lv.${level}`;
                
                for (let i = 0; i < this.activeHexes.length; i++) {
                    let obj = this.activeHexes[i];
                    obj.y += this.speed; obj.el.style.top = obj.y + 'px';
                    if (obj.y + HEX_HEIGHT > DANGER_Y) {
                        triggerGameOver(this); 
                        return;
                    }
                }
                
                this.topMostY += this.speed;
                if (this.topMostY > -ROW_HEIGHT) this.generateRow(this.topMostY - ROW_HEIGHT);
            }

            spawnParticles(x, y) {
                for (let i = 0; i < 5; i++) {
                    let p = document.createElement('div'); p.classList.add('particle');
                    p.style.left = `${x}px`; p.style.top = `${y}px`; this.container.appendChild(p);
                    let angle = Math.random() * Math.PI * 2; let dist = Math.random() * 40 + 20;
                    setTimeout(() => { p.style.transform = `translate(${Math.cos(angle)*dist}px, ${Math.sin(angle)*dist}px) scale(0) rotate(${Math.random()*360}deg)`; p.style.opacity = '0'; }, 10);
                    setTimeout(() => p.remove(), 600);
                }
            }

            spawnFloatingText(x, y, text, color) {
                let txt = document.createElement('div'); txt.classList.add('floating-text');
                txt.innerText = text; txt.style.color = color; txt.style.left = `${x}px`; txt.style.top = `${y}px`;
                this.container.appendChild(txt); setTimeout(() => txt.remove(), 1000);
            }
        }

        function gameLoop() {
            if (globalGameOver) return;
            players.forEach(p => p.update());
            mainLoopId = requestAnimationFrame(gameLoop);
        }

        function triggerGameOver(loser) {
            globalGameOver = true;
            cancelAnimationFrame(mainLoopId);
            stopBGM();
            playGameOverSound();
            fireConfetti();
            
            const winnerDisplay = document.getElementById('winner-display');
            if (config.players === 1) {
                winnerDisplay.innerText = `挑戰結束！\n得分: ${players[0].score}`;
            } else {
                let alivePlayers = players.filter(p => p !== loser);
                let winner = alivePlayers.sort((a, b) => b.score - a.score)[0];
                winnerDisplay.innerText = `🏆 ${winner.theme.name} 獲勝 🏆`;
            }

            document.getElementById('game-over-screen').classList.remove('hidden');
        }

        // --- 華麗紙片噴發特效 ---
        function fireConfetti() {
            const colors = ['#fce18a', '#ff726d', '#b48def', '#f4306d', '#4CAF50', '#00BCD4'];
            for(let i = 0; i < 150; i++) {
                let conf = document.createElement('div');
                conf.classList.add('confetti');
                conf.style.left = Math.random() * 100 + 'vw';
                conf.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                
                let duration = Math.random() * 3 + 2;
                let delay = Math.random() * 2;
                conf.style.animationDuration = `${duration}s`;
                conf.style.animationDelay = `${delay}s`;
                
                document.body.appendChild(conf);
                setTimeout(() => conf.remove(), (duration + delay) * 1000);
            }
        }
    </script>
</body>
</html>
